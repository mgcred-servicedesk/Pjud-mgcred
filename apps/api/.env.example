# Desenvolvimento local (copie para apps/api/.env)
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5433/mgcred
# Com o Vite (pnpm dev:web) a origem é a do Vite; servindo apps/web/dist pela API use http://127.0.0.1:4320
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development
HOST=127.0.0.1
PORT=4320
# WEB_DIST=../web/dist
# No Render: CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_IP_HEADER=
MAX_STORAGE_BYTES=2147483648
# Administrador inicial criado na inicialização da API, só enquanto não houver nenhum (senha: 14 a 128 caracteres)
# BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.test
# BOOTSTRAP_ADMIN_PASSWORD=
