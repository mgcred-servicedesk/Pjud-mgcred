# Para produção, substitua o domínio, ative NODE_ENV=production e use o proxy HTTPS.
APP_ORIGIN=http://127.0.0.1:4320
NODE_ENV=development
HOST=127.0.0.1
PORT=4320
DATA_DIR=./data
BACKUP_DIR=./backups
MAX_STORAGE_BYTES=2147483648
TRUST_PROXY=0
# Docker Compose usa DOMAIN para o Caddy e APP_ORIGIN=https://DOMAIN automaticamente.
DOMAIN=juridico.seu-dominio.com.br
ACME_EMAIL=ti@seu-dominio.com.br
